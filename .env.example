# ========== LLM（OpenAI 兼容接口，示例为火山方舟 Ark）==========
# 复制本文件为 .env 后填写自己的密钥，切勿提交 .env
VOLC_ARK_KEY=your_ark_api_key
VOLC_MODEL_EP=your_endpoint_id
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=50.0

# ========== Embedding + Rerank（阿里百炼 DashScope）==========
DASHSCOPE_API_KEY=your_dashscope_api_key
EMBED_MODEL=text-embedding-v4
RERANK_MODEL=gte-rerank-v2

# ========== RAG 参数 ==========
CHUNK_SIZE=400
CHUNK_OVERLAP=60
RETRIEVE_TOP_K=5
RERANK_TOP_K=3
SIMILAR_THRESHOLD=0.20
DEBUG_SIMILARITY=False

# ========== 检索依赖治理 ==========
EMBED_CONNECT_TIMEOUT=3.0
EMBED_TIMEOUT=8.0
RERANK_TIMEOUT=6.0
RETRIEVAL_COOLDOWN=60.0
EMBED_MAX_CONCURRENCY=4
RETRIEVAL_CACHE_SIZE=256
RETRIEVAL_CACHE_TTL=300.0
CORPUS_CACHE_TTL=600.0

# ========== 线程池与连接池 ==========
DB_EXECUTOR_WORKERS=4
IO_EXECUTOR_WORKERS=8
LLM_MAX_CONNECTIONS=32
SQLITE_BUSY_TIMEOUT=5.0

# ========== Agent 与会话 ==========
MAX_AGENT_STEPS=4
MAX_CHAT_TURN=6

# ========== 风控阈值 ==========
AUTO_REFUND_MAX_AMOUNT=50
APPROVAL_REFUND_MAX=500
USER_DAILY_REFUND_LIMIT=3
